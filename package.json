{
  "name": "creators-of-fire",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The Creators of Fire AI music experience",
  "scripts": {
    "dev": "npm run build:wallet && node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "sync": "python3 scripts/sync_catalog.py",
    "build:wallet": "node scripts/build-wallet.mjs",
    "fire:encrypt": "node scripts/encrypt-fire.mjs",
    "fire:worker:dev": "wrangler dev --config workers/fire-access/wrangler.jsonc",
    "fire:worker:check": "wrangler deploy --dry-run --config workers/fire-access/wrangler.jsonc --outdir /tmp/creators-fire-worker",
    "test:browser": "npm run build && playwright test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@near-wallet-selector/core": "10.1.4",
    "@near-wallet-selector/meteor-wallet": "10.1.4",
    "buffer": "6.0.3",
    "process": "0.11.10",
    "util": "0.12.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "borsh": "2.0.0",
    "esbuild": "0.28.2",
    "wrangler": "4.151.0"
  },
  "overrides": {
    "nanoid": "5.1.16",
    "decode-uri-component": "0.5.0"
  }
}
